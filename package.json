{
  "name": "monikers",
  "version": "1.0.0",
  "engines": {
    "node": ">=18"
  },
  "description": "A browser based adaptation of the card game Monikers. Uses socket.io and vue.js",
  "repository": {
    "type": "github",
    "url": "git+https://github.com/james-whitehead/monikers-js.git"
  },
  "main": "src/server/main.js",
  "scripts": {
    "test": "mocha --exit",
    "deploy": "gh-pages -d build",
    "build": "webpack --env production && pnpm run sass",
    "watch": "webpack --env development -w",
    "sass": "sass src/public/style/style.scss:src/public/style/style.css --style compressed",
    "sass-dev": "sass --watch src/public/style/style.scss:src/public/style/style.css --style compressed",
    "start": "node ./src/server/main.js"
  },
  "author": "ootachi",
  "license": "MIT",
  "dependencies": {
    "@vue/compiler-sfc": "^3.5.34",
    "ajv": "^8.20.0",
    "compression": "^1.7.4",
    "csv-parse": "^6.2.1",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.34",
    "vue-loader": "^17.4.2",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  },
  "devDependencies": {
    "async": "^3.2.6",
    "chai": "^4.2.0",
    "mocha": "^11.7.5",
    "sass": "^1.94.2"
  },
  "bugs": {
    "url": "https://github.com/james-whitehead/monikers-js/issues"
  },
  "homepage": "https://github.com/james-whitehead/monikers-js#readme",
  "directories": {
    "test": "test"
  },
  "pnpm": {
    "overrides": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  }
}
